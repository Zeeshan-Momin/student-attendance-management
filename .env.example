# Copy this file to .env and fill in the required values before running locally or deploying.
DB_URL=jdbc:mysql://localhost:3306/student_attendance?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DRIVER=com.mysql.cj.jdbc.Driver
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
H2_CONSOLE_ENABLED=false
